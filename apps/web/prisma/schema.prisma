generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  VIEWER
  OPERATOR
  ADMINISTRATOR
  AUDITOR
}

enum ObservationSource {
  HOST_AGENT
  GITLAB
}

enum OperationType {
  PROVISION_PROJECT_RUNNER
}

enum OperationState {
  REQUESTED
  AUTHORIZED
  DISPATCHED
  RUNNING
  SUCCEEDED
  FAILED
  PARTIALLY_FAILED
  UNKNOWN
  CANCELLED
  EXPIRED
}

enum ProvisioningStage {
  AUTHORIZATION
  GITLAB_RUNNER_CREATION
  HOST_PREPARATION
  RUNNER_REGISTRATION
  VERIFICATION
  FIRST_OBSERVATION
}

model User {
  id              String           @id @default(cuid())
  externalSubject String           @unique
  displayName     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  roles           RoleAssignment[]
}

model RoleAssignment {
  id        String       @id @default(cuid())
  userId    String
  role      PlatformRole
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model RunnerHost {
  id               String            @id
  displayName      String
  enrolledAt       DateTime
  revokedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  stacks           RunnerStack[]
  agentCredentials AgentCredential[]
}

model AgentCredential {
  id            String       @id
  runnerHostId  String
  runnerStackId String?
  tokenDigest   String
  createdAt     DateTime     @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  runnerHost    RunnerHost   @relation(fields: [runnerHostId], references: [id], onDelete: Cascade)
  runnerStack   RunnerStack? @relation(fields: [runnerStackId], references: [id], onDelete: Cascade)

  @@index([runnerHostId])
  @@index([runnerStackId])
}

model RunnerStack {
  id                 String                  @id
  canonicalName      String
  workload           String
  hostId             String
  templateRevisionId String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  host               RunnerHost              @relation(fields: [hostId], references: [id], onDelete: Restrict)
  templateRevision   RunnerTemplateRevision? @relation(fields: [templateRevisionId], references: [id], onDelete: Restrict)
  runnerRecord       RunnerRecordRef?
  observations       Observation[]
  agentCredentials   AgentCredential[]

  @@index([hostId, canonicalName])
  @@index([templateRevisionId])
}

model GitLabProjectRef {
  id              String      @id
  gitlabProjectId String      @unique
  path            String      @unique
  enabled         Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  operations      Operation[]
}

model RunnerTemplate {
  id            String                   @id
  canonicalName String                   @unique
  workload      String
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  revisions     RunnerTemplateRevision[]
}

model RunnerTemplateRevision {
  id               String         @id
  runnerTemplateId String
  revision         String
  policy           Json
  approvedAt       DateTime
  retiredAt        DateTime?
  createdAt        DateTime       @default(now())
  runnerTemplate   RunnerTemplate @relation(fields: [runnerTemplateId], references: [id], onDelete: Restrict)
  runnerStacks     RunnerStack[]
  operations       Operation[]

  @@unique([runnerTemplateId, revision])
  @@index([retiredAt])
}

model Operation {
  id                       String                 @id
  type                     OperationType
  state                    OperationState
  actorId                  String
  reason                   String
  idempotencyKey           String                 @unique
  correlationId            String                 @unique
  gitlabProjectRefId       String
  runnerTemplateRevisionId String
  parameters               Json
  redactedOutcome          Json?
  requestedAt              DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  availableAt              DateTime               @default(now())
  leaseOwner               String?
  leaseExpiresAt           DateTime?
  attemptCount             Int                    @default(0)
  completedAt              DateTime?
  gitlabProjectRef         GitLabProjectRef       @relation(fields: [gitlabProjectRefId], references: [id], onDelete: Restrict)
  runnerTemplateRevision   RunnerTemplateRevision @relation(fields: [runnerTemplateRevisionId], references: [id], onDelete: Restrict)
  events                   OperationEvent[]

  @@index([state, availableAt])
  @@index([gitlabProjectRefId])
  @@index([runnerTemplateRevisionId])
}

model OperationEvent {
  id          String             @id
  operationId String
  sequence    Int
  state       OperationState
  stage       ProvisioningStage?
  eventType   String
  payload     Json
  occurredAt  DateTime           @default(now())
  operation   Operation          @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@unique([operationId, sequence])
  @@index([occurredAt])
}

model RunnerRecordRef {
  id             String      @id @default(cuid())
  runnerStackId  String      @unique
  gitlabRunnerId String      @unique
  projectPath    String
  runnerStack    RunnerStack @relation(fields: [runnerStackId], references: [id], onDelete: Cascade)
}

model Observation {
  id             String            @id @default(cuid())
  runnerStackId  String
  source         ObservationSource
  deliveryId     String?
  deliveryDigest String?
  schemaVersion  String
  observedAt     DateTime
  payload        Json
  createdAt      DateTime          @default(now())
  runnerStack    RunnerStack       @relation(fields: [runnerStackId], references: [id], onDelete: Cascade)

  @@unique([runnerStackId, source, deliveryId])
  @@index([runnerStackId, source, observedAt])
}

model AuditEvent {
  id            String   @id @default(cuid())
  correlationId String
  actorId       String
  eventType     String
  targetType    String
  targetId      String
  payload       Json
  occurredAt    DateTime @default(now())

  @@index([occurredAt])
  @@index([correlationId])
}
