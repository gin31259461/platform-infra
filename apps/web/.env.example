PLATFORM_OBSERVATION_INGESTION=enabled
# Enabled by default. Set disabled to opt out of one Host observation after each Control Plane start.
PLATFORM_FORCE_HOST_REFRESH_ON_START=enabled
PLATFORM_HOST_FRESHNESS_SECONDS=90
PLATFORM_GITLAB_FRESHNESS_SECONDS=300
GITLAB_SYNC_INTERVAL_SECONDS=60
# Optional absolute path. Never put a token in this file.
# GITLAB_CREDENTIAL_DIRECTORY=/home/runner-platform/.config/gitlab-runner-platform/credentials
DATABASE_URL=postgresql://runner_platform:replace_me@127.0.0.1:5432/runner_platform
GITLAB_BASE_URL=https://gitlab.example.invalid
